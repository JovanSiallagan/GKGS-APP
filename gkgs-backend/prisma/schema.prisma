// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql" // Ubah ke "mysql" jika Anda menggunakan MySQL
  url      = env("DATABASE_URL")
}

// Tabel untuk Jemaat/Pengguna
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String

  // --- TAMBAHAN DATA PROFIL ---
  dob       DateTime? // Tanggal Lahir (Date of Birth)
  gender    String?   // Jenis Kelamin ('L' atau 'P')
  address   String?   // Alamat
  phone     String?   // Nomor Telepon

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi: Satu user bisa membuat banyak postingan di Papan Interaksi
  posts     CommunityPost[]
  attendances Attendance[]
}

// Tabel untuk Renungan (Sesuai dengan model FamilyAltar di Flutter)
model FamilyAltar {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  description String
  bibleVerse  String
  content     String   @db.Text // Menggunakan Text karena isi renungan biasanya panjang
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tipe Postingan untuk Papan Interaksi
enum PostType {
  PRAYER      // Doa
  TESTIMONY   // Kesaksian
}

// Tabel untuk Papan Interaksi (Sesuai dengan model CommunityPost di Flutter)
model CommunityPost {
  id        String   @id @default(uuid())
  content   String   @db.Text
  type      PostType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi: Setiap postingan dimiliki oleh satu User
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

// Tabel untuk Acara / Event Gereja
model Event {
  id          String       @id @default(uuid())
  title       String
  date        DateTime
  description String?
  totalHadir  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relasi: Satu acara bisa dihadiri banyak orang (Attendance)
  attendances Attendance[]
}

// Tabel untuk Presensi (Smart QR Check-in)
model Attendance {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Relasi ke User (Siapa yang hadir)
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  // Relasi ke Event (Hadir di acara apa)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
}


model Warta {
  id              String   @id @default(uuid())
  tanggal         DateTime @default(now())
  judul           String
  imageUrl        String?  // Boleh kosong, nanti di Flutter dikasih gambar default
  khotbahJudul    String
  khotbahAyat     String
  khotbahIsi      String
  jadwalPelayanan String   // Input di Prisma: Peran: Nama (pisahkan tiap jadwal dengan Enter)
  infoPenting     String   // Input di Prisma: Pisahkan tiap poin dengan Enter
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}